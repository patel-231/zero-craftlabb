# =========================================================
# ZERO CRAFTLABB — CONFIGURATION ENVIRONMENT VARIABLES
# =========================================================

# Administrator initial setup password (used to initialize admin account on first start)
ADMIN_INITIAL_PASSWORD="CraftLabb@2026!Secure"

# =========================================================
# TRANSACTIONAL EMAIL PROVIDER (BREVO / RESEND)
# =========================================================
# Brevo (formerly Sendinblue) provides 300 free emails per day.
# Get your API key from: https://app.brevo.com/settings/keys/api
# You can also configure this directly in the Admin Panel at /admin/settings!
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="orders@zerocraftlabb.com"
BREVO_SENDER_NAME="Zero Craftlabb"

# Optional Alternative: Resend API Key
RESEND_API_KEY=""
EMAIL_FROM="Zero Craftlabb <orders@resend.dev>"

# Server Port & Environment
PORT=3000
NODE_ENV="development"
